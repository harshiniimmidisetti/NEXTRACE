# Copy to .env. Never commit real values.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
DATABASE_URL=sqlite:///./nextrace.db
# PostgreSQL example: postgresql+psycopg2://nextrace:CHANGE_ME@localhost:5432/nextrace
CORS_ORIGINS=http://localhost:8080,https://your-site.netlify.app
APP_MODE=demo
# Optional: ANTHROPIC_API_KEY=  (assistant stays in deterministic demo mode when empty)
# NEXA (Claude runs on the server only; never put this key in frontend code)
ANTHROPIC_API_KEY=
NEXA_MODEL=claude-sonnet-5-5
NEXA_MAX_TOKENS=800
NEXA_DAILY_LIMIT=50
